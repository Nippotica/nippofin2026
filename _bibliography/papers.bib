@article{machimbo2025applications,
  title={Applications of Hidden Markov Models in Detecting Regime Changes in Bitcoin Markets},
  author={Machimbo, Elijah Wanjala and Cheruiyot, Wycliffe and Mocheche, George and Mutegi, Joy},
  journal={Asian Journal of Probability and Statistics},
  volume={27},
  number={7},
  pages={127--138},
    abbr={AJPAS},
  abstract = {This study explores the identification and assessment of regime shifts in Bitcoin markets through the application of advanced statistical models, namely HMMs, MSMs, and Threshold Models. The analysis utilizes key financial indicators including market capitalization, volatility, trading volume, and historical Bitcoin price data, along with statistical measures such as mean, minimum, and maximum values to enhance the detection of market patterns. Distinctions are made between bullish (sustained price increases exceeding 20\%), bearish (sustained price declines exceeding 20\%), and neutral (periods of low volatility and sideways movement) market regimes. HMMs provide predictive insights into market transitions, MSMs are employed to capture structural regime changes, and the Threshold Model identifies significant price behaviors.},
  year={2025}
}
